# Agent Marketplace Example Environment Variables

# Seller's wallet address (receives payments)
# This is where USDC payments will be settled
SELLER_ADDRESS=0x

# Buyer's private key (for client.ts and deposit.py)
# Get testnet USDC from: https://faucet.circle.com
PRIVATE_KEY=0x

# Server port (optional, default: 4021)
PORT=4021

# Server URL for client (optional, default: http://localhost:4021)
SERVER_URL=http://localhost:4021
